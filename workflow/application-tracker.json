      "id": "a513d7fa-2f8f-4d86-bcd6-a3c35ffb6605",
      "name": "Route Message Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        464,
        912
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = String($json.message.text || '').trim();\nconst match = text.match(/^(\\S+)\\s+(\\S+)(?:\\s+([\\s\\S]*))?$/);\n\nconst platforms = {\n  up: 'Upwork',\n  fh: 'Freelancehunt',\n  li: 'LinkedIn',\n  dou: 'DOU',\n};\nconst types = {\n  'п': 'Відгук на проєкт',\n  'в': 'Відгук на вакансію',\n  'о': 'Персональний офер',\n};\n\nconst zone = 'Europe/Lisbon';\nconst today = $now.setZone(zone);\n\nif (!match) {\n  return { json: { valid: false, error: 'Немає мітки. Формат: платформа тип [дата] текст, наприклад: up п ...', platform: '', type: '', date: '', dateIso: '', requirements: '' } };\n}\n\nconst platformKey = match[1].toLowerCase();\nconst typeKey = match[2].toLowerCase();\nconst platform = platforms[platformKey] || match[1];\nconst type = types[typeKey];\n\nif (!type) {\n  return { json: { valid: false, error: 'Нерозпізнаний тип \"' + match[2] + '\". Дозволені: п (проєкт), в (вакансія), о (офер)', platform, type: '', date: '', dateIso: '', requirements: (match[3] || '').trim() } };\n}\n\nlet date = today.toFormat('dd.MM');\nlet dateIso = today.toFormat('yyyy-MM-dd');\nlet requirements = (match[3] || '').trim();\n\nconst next = requirements.match(/^(\\S+)(?:\\s+([\\s\\S]*))?$/);\nif (next) {\n  const token = next[1];\n  const dm = token.match(/^(\\d{1,2})\\.(\\d{1,2})$/);\n  if (dm) {\n    const candidate = DateTime.fromObject({ year: today.year, month: Number(dm[2]), day: Number(dm[1]) }, { zone });\n    if (candidate.isValid) {\n      date = candidate.toFormat('dd.MM');\n      dateIso = candidate.toFormat('yyyy-MM-dd');\n      requirements = (next[2] || '').trim();\n    }\n  } else if (token.toLowerCase() === 'вчора') {\n    const yesterday = today.minus({ days: 1 });\n    date = yesterday.toFormat('dd.MM');\n    dateIso = yesterday.toFormat('yyyy-MM-dd');\n    requirements = (next[2] || '').trim();\n  }\n}\n\nreturn { json: { valid: true, error: '', platform, type, date, dateIso, requirements } };"
      },
