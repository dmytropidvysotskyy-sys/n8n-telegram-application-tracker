        "mode": "runOnceForEachItem",
        "jsCode": "const reply = $json.message.reply_to_message || {};\nconst replyText = String(reply.text || '');\nconst cl = String($json.message.text || '').trim();\n\nconst match = replyText.match(/^Рядок (\\d+) створено/);\nconst fromBot = Boolean(reply.from && reply.from.is_bot);\n\nif (!match || !fromBot) {\n  return { json: { valid: false, error: 'Не знайшов номер рядка. Дайте reply на повідомлення \"Рядок N створено\"', rowNumber: null, cl } };\n}\n\nreturn { json: { valid: true, error: '', rowNumber: Number(match[1]), cl } };"
      },
