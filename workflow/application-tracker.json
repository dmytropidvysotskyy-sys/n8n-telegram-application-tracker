        "jsCode": "const msg = $json.message;\nconst reply = msg.reply_to_message || {};\nconst replyText = String(reply.text || '');\n\nconst match = replyText.match(/^(?:Рядок (\\d+) створено|CL для рядка (\\d+) збережено)/);\nconst fromBot = Boolean(reply.from && reply.from.is_bot);\n\nlet fileId = '';\nlet ext = '';\n\nif (msg.document) {\n  fileId = msg.document.file_id;\n  const name = String(msg.document.file_name || '');\n  const dot = name.lastIndexOf('.');\n  ext = dot >= 0 ? name.slice(dot + 1).toLowerCase() : '';\n  if (!ext) {\n    ext = String(msg.document.mime_type || '').split('/')[1] || 'bin';\n  }\n} else if (Array.isArray(msg.photo) && msg.photo.length) {\n  fileId = msg.photo[msg.photo.length - 1].file_id;\n  ext = 'jpg';\n}\n\nif (!match || !fromBot || !fileId) {\n  return { json: { valid: false, error: 'Не знайшов номер рядка. Дайте reply на повідомлення \"Рядок N створено\" або \"CL для рядка N збережено\" файлом або фото', rowNumber: null, fileId, fileName: '' } };\n}\n\nconst rowNumber = Number(match[1] || match[2]);\n\nreturn { json: { valid: true, error: '', rowNumber, fileId, fileName: rowNumber + '.' + ext } };"
      },
