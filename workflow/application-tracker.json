        "jsCode": "const numbers = $input.all()\n  .map((item) => Number(item.json['№']))\n  .filter((n) => Number.isFinite(n) && n > 0);\n\nconst number = (numbers.length ? Math.max(...numbers) : 0) + 1;\n\nreturn [{ json: { number } }];"
